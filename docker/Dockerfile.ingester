FROM golang:1.22-alpine AS builder
RUN apk --no-cache add gcc musl-dev
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -tags musl -ldflags="-s -w" -o /bin/ingester ./cmd/ingester

FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata librdkafka
COPY --from=builder /bin/ingester /bin/ingester
EXPOSE 2112
ENTRYPOINT ["/bin/ingester"]
