FROM golang:1.22-alpine AS builder
RUN apk --no-cache add gcc musl-dev
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -tags musl -ldflags="-s -w" -o /bin/api ./cmd/api

FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata librdkafka
COPY --from=builder /bin/api /bin/api
EXPOSE 8080 2114
ENTRYPOINT ["/bin/api"]
